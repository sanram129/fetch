<!-- Default scene for the robot -->
<mujoco model="scene">
  <include file="robot_model/Main_Robot-v8/Main_Robot-v8.xml"/>
  <visual>
    <headlight diffuse=".6 .6 .6" ambient=".3 .3 .3"/>
    <global azimuth="130" elevation="-25"/>
  </visual>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1=".4 .6 .8" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="grid" builtin="checker" rgb1=".2 .3 .4" rgb2=".1 .2 .3" width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="5 5" reflectance=".2"/>
  </asset>
  <worldbody>
    <geom name="ground" type="plane" size="5 5 .05" material="grid" contype="1" conaffinity="1"/>
    <!-- the ball we will move around -->
    <body name="ball" pos="-0.6 0 0.05">
      <freejoint name="ball_free"/>
      <inertial pos="0 0 0" mass="0.05" diaginertia="5e-5 5e-5 5e-5"/>
      <geom name="ball_geom" type="sphere" size="0.05" mass="0.05"
            rgba="1 0 0 1" contype="1" conaffinity="1"
            condim="6" friction="1 0.005 0.0001"/>
    </body>
  </worldbody>
</mujoco>