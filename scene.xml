<!-- Default scene for the robot -->
<mujoco model="scene">
  <include file="robot_model/Main_Robot-v8/Main_Robot-v8.xml"/>
  <visual>
    <headlight diffuse=".6 .6 .6" ambient=".3 .3 .3"/>
    <global azimuth="130" elevation="-25"/>
  </visual>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1=".4 .6 .8" rgb2="0 0 0" width="512" height="3072"/>
