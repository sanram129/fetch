<mujoco model="scene">
  <include file="robot_model/Main_Robot-v8/Main_Robot-v8.xml"/>

  <visual>
    <headlight diffuse=".5 .5 .5" ambient=".3 .3 .3"/>
    <global azimuth="130" elevation="-25"/>
    <map znear="0.005"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1=".5 .7 .9" rgb2=".1 .1 .2" width="512" height="3072"/>
    <texture type="2d" name="tile" builtin="checker" rgb1=".75 .72 .65" rgb2=".68 .65 .58" width="300" height="300"/>
    <material name="floor" texture="tile" texrepeat="8 6" reflectance="0.05"/>
  </asset>

  <worldbody>
    <light pos="0 0 2.5" dir="0 0 -1" diffuse=".7 .7 .7" castshadow="true"/>

    <!-- floor: room interior is x -2..2, y -1.5..1.5 -->
    <geom name="floor" type="plane" size="2 1.5 0.05" material="floor" contype="1" conaffinity="1" friction="1 0.005 0.0001"/>

    <!-- walls (1.5 m tall) -->
    <geom name="wall_front" type="box" pos="-2.05 0 0.75" size="0.05 1.6 0.75" rgba=".92 .92 .88 1" contype="1" conaffinity="1"/>
    <geom name="wall_back"  type="box" pos=" 2.05 0 0.75" size="0.05 1.6 0.75" rgba=".92 .92 .88 1" contype="1" conaffinity="1"/>
    <geom name="wall_left"  type="box" pos="0 -1.55 0.75" size="2.1 0.05 0.75" rgba=".88 .90 .92 1" contype="1" conaffinity="1"/>
    <geom name="wall_right" type="box" pos="0  1.55 0.75" size="2.1 0.05 0.75" rgba=".88 .90 .92 1" contype="1" conaffinity="1"/>

    <!-- whiteboard on the wall the robot faces (visual only) -->
    <geom name="whiteboard" type="box" pos="-1.99 0 0.9" size="0.01 0.8 0.35" rgba="1 1 1 1" contype="0" conaffinity="0"/>

    <!-- rug: thin and grippy -->
    <geom name="rug" type="box" pos="-0.6 0 0.004" size="0.7 0.5 0.00002" rgba=".55 .45 .15 1"
          contype="1" conaffinity="1" friction="1.5 0.005 0.0001"/>

    <!-- low obstacle to step around -->
    <geom name="block" type="box" pos="-1.3 0.7 0.03" size="0.12 0.12 0.03" rgba=".2 .4 .8 1" contype="1" conaffinity="1"/>

    <!-- desk 1 -->
    <body name="desk1" pos="1.2 1.0 0">
      <geom type="box" pos="0 0 0.72" size="0.5 0.3 0.02" rgba=".6 .4 .2 1" contype="1" conaffinity="1"/>
      <geom type="box" pos=" 0.46  0.26 0.35" size="0.02 0.02 0.35" rgba=".3 .3 .3 1" contype="1" conaffinity="1"/>
      <geom type="box" pos="-0.46  0.26 0.35" size="0.02 0.02 0.35" rgba=".3 .3 .3 1" contype="1" conaffinity="1"/>
      <geom type="box" pos=" 0.46 -0.26 0.35" size="0.02 0.02 0.35" rgba=".3 .3 .3 1" contype="1" conaffinity="1"/>
      <geom type="box" pos="-0.46 -0.26 0.35" size="0.02 0.02 0.35" rgba=".3 .3 .3 1" contype="1" conaffinity="1"/>
    </body>

    <!-- desk 2 -->
    <body name="desk2" pos="-1.2 -1.0 0">
      <geom type="box" pos="0 0 0.72" size="0.5 0.3 0.02" rgba=".6 .4 .2 1" contype="1" conaffinity="1"/>
      <geom type="box" pos=" 0.46  0.26 0.35" size="0.02 0.02 0.35" rgba=".3 .3 .3 1" contype="1" conaffinity="1"/>
      <geom type="box" pos="-0.46  0.26 0.35" size="0.02 0.02 0.35" rgba=".3 .3 .3 1" contype="1" conaffinity="1"/>
      <geom type="box" pos=" 0.46 -0.26 0.35" size="0.02 0.02 0.35" rgba=".3 .3 .3 1" contype="1" conaffinity="1"/>
      <geom type="box" pos="-0.46 -0.26 0.35" size="0.02 0.02 0.35" rgba=".3 .3 .3 1" contype="1" conaffinity="1"/>
    </body>

    <!-- bookshelf against the back wall -->
    <geom name="shelf" type="box" pos="1.8 0 0.5" size="0.15 0.5 0.5" rgba=".4 .28 .15 1" contype="1" conaffinity="1"/>

    <!-- the red ball -->
    <body name="ball" pos="-0.6 0 0.06">
      <freejoint name="ball_free"/>
      <inertial pos="0 0 0" mass="0.05" diaginertia="5e-5 5e-5 5e-5"/>
      <geom name="ball_geom" type="sphere" size="0.05" rgba="1 0 0 1"
            contype="1" conaffinity="1" condim="6" friction="1 0.005 0.0001"/>
    </body>
  </worldbody>
</mujoco>